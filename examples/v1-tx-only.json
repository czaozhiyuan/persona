{
  "format": "persona-project",
  "schemaVersion": 2,
  "project": {
    "id": "v1-tx-only",
    "name": "V1 独立发射机箱（示例参数）",
    "rootModuleDefinitionId": "system",
    "componentDefinitions": [
      {
        "kind": "component",
        "id": "rf-source",
        "name": "射频信号源",
        "ports": [
          {
            "id": "OUT",
            "name": "输出",
            "type": "RF",
            "direction": "out"
          }
        ]
      },
      {
        "kind": "component",
        "id": "mzm",
        "name": "调制器（MZM）",
        "ports": [
          {
            "id": "RF_IN",
            "name": "射频输入",
            "type": "RF",
            "direction": "in"
          },
          {
            "id": "SUPPLY",
            "name": "供光输入",
            "type": "OPTICAL",
            "direction": "in",
            "channelIds": [
              "DWDM_CH28",
              "DWDM_CH30"
            ]
          },
          {
            "id": "OUT",
            "name": "输出",
            "type": "OPTICAL",
            "direction": "out",
            "channelIds": [
              "DWDM_CH28",
              "DWDM_CH30"
            ]
          }
        ],
        "parameters": [
          {
            "id": "insertionLoss",
            "name": "最大透过状态光插损",
            "kind": "numeric",
            "unit": "dB",
            "valueKind": "opticalValue",
            "range": {
              "min": 0
            },
            "defaultValue": {
              "kind": "fixed",
              "value": 3
            },
            "overridable": true
          },
          {
            "id": "vPi",
            "name": "RF 半波电压 Vπ",
            "kind": "numeric",
            "unit": "V",
            "valueKind": "rfValue",
            "defaultValue": {
              "kind": "fixed",
              "value": 5
            },
            "overridable": true,
            "range": {
              "min": 5e-324
            }
          }
        ],
        "transfers": [
          {
            "kind": "eo",
            "fromPortId": "RF_IN",
            "toPortId": "OUT",
            "supplyPortId": "SUPPLY",
            "insertionLossDb": {
              "kind": "parameter",
              "parameterId": "insertionLoss"
            },
            "vPi": {
              "kind": "parameter",
              "parameterId": "vPi"
            }
          }
        ]
      },
      {
        "kind": "component",
        "id": "demo-laser",
        "name": "激光器",
        "ports": [
          {
            "id": "OUT",
            "name": "输出",
            "type": "OPTICAL",
            "direction": "out",
            "channelIds": [
              "DWDM_CH28",
              "DWDM_CH30"
            ],
            "opticalEmitter": {
              "powerDbm": {
                "kind": "parameter",
                "parameterId": "power"
              }
            }
          }
        ],
        "parameters": [
          {
            "id": "power",
            "name": "信号光输出功率",
            "kind": "numeric",
            "unit": "dBm",
            "valueKind": "opticalValue",
            "defaultValue": {
              "kind": "fixed",
              "value": 8.0102999566
            },
            "overridable": true
          }
        ]
      },
      {
        "kind": "component",
        "id": "demo-switch",
        "name": "光开关",
        "ports": [
          {
            "id": "IN",
            "name": "输入",
            "type": "OPTICAL",
            "direction": "in"
          },
          {
            "id": "OUT",
            "name": "输出",
            "type": "OPTICAL",
            "direction": "out"
          }
        ],
        "switchStates": [
          {
            "id": "pass",
            "name": "导通",
            "routes": [
              {
                "fromPortId": "IN",
                "toPortId": "OUT",
                "gainDb": {
                  "kind": "fixed",
                  "value": -2
                }
              }
            ]
          },
          {
            "id": "block",
            "name": "阻断",
            "routes": []
          }
        ]
      }
    ],
    "moduleDefinitions": [
      {
        "kind": "module",
        "id": "system",
        "name": "系统",
        "ports": [],
        "instances": [
          {
            "id": "TX_A",
            "name": "发射机箱 A",
            "definitionId": "tx"
          }
        ]
      },
      {
        "kind": "module",
        "id": "tx",
        "name": "发射机箱",
        "ports": [
          {
            "id": "OPT_OUT",
            "name": "光输出",
            "type": "OPTICAL",
            "direction": "out",
            "channelIds": [
              "DWDM_CH28",
              "DWDM_CH30"
            ]
          },
          {
            "id": "TEST_OUT",
            "name": "测试输出",
            "type": "OPTICAL",
            "direction": "out",
            "channelIds": [
              "DWDM_CH28"
            ]
          }
        ],
        "instances": [
          {
            "id": "source",
            "name": "射频信号源",
            "definitionId": "rf-source"
          },
          {
            "id": "mzm",
            "name": "调制器（MZM）",
            "definitionId": "mzm"
          },
          {
            "id": "laser",
            "name": "激光器",
            "definitionId": "demo-laser"
          },
          {
            "id": "optical-switch",
            "name": "光开关",
            "definitionId": "demo-switch",
            "switchStateId": "pass"
          }
        ],
        "portMappings": [
          {
            "portId": "OPT_OUT",
            "target": {
              "instanceId": "optical-switch",
              "portId": "OUT"
            }
          }
        ],
        "parameters": [
          {
            "id": "insertionLoss",
            "name": "最大透过状态光插损",
            "kind": "numeric",
            "unit": "dB",
            "valueKind": "opticalValue",
            "range": {
              "min": 0
            },
            "defaultValue": {
              "kind": "fixed",
              "value": 3
            },
            "overridable": true
          }
        ],
        "parameterMappings": [
          {
            "parameterId": "insertionLoss",
            "target": {
              "instanceId": "mzm",
              "parameterId": "insertionLoss"
            }
          }
        ],
        "physicalEnclosure": {
          "widthMm": 440,
          "depthMm": 350,
          "heightMm": 44.45
        },
        "connections": [
          {
            "id": "rf-feed",
            "from": {
              "instanceId": "source",
              "portId": "OUT"
            },
            "to": {
              "instanceId": "mzm",
              "portId": "RF_IN"
            },
            "mediaKind": "RF_COAX"
          },
          {
            "id": "laser-feed",
            "from": {
              "instanceId": "laser",
              "portId": "OUT"
            },
            "to": {
              "instanceId": "mzm",
              "portId": "SUPPLY"
            },
            "mediaKind": "OPTICAL_FIBER"
          },
          {
            "id": "mzm-switch",
            "from": {
              "instanceId": "mzm",
              "portId": "OUT"
            },
            "to": {
              "instanceId": "optical-switch",
              "portId": "IN"
            },
            "mediaKind": "OPTICAL_FIBER"
          }
        ]
      }
    ],
    "instanceSettings": [
      {
        "instancePath": [
          "TX_A",
          "optical-switch"
        ],
        "switchStateId": "pass"
      }
    ],
    "namedLinks": [
      {
        "id": "tx-only",
        "name": "未完成发射链路",
        "channelId": "DWDM_CH28",
        "from": {
          "instancePath": [
            "TX_A"
          ],
          "portId": "OPT_OUT"
        }
      }
    ]
  }
}
