{
  "name": "persona",
  "version": "0.0.1",
  "description": "PERSONA offline optoelectronic design workbench",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:v1",
    "build:v1": "tsc --noEmit && vite build && tsx scripts/package-artifacts.ts",
    "test:v1:model": "tsx --test tests/v1/*.test.ts",
    "verify": "npm run test:v1:model && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czaozhiyuan/persona.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/czaozhiyuan/persona/issues"
  },
  "homepage": "https://github.com/czaozhiyuan/persona#readme",
  "dependencies": {
    "@xyflow/react": "^12.12.1",
    "elkjs": "0.12.2",
    "konva": "^10.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
